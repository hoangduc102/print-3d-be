# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1
API_PREFIX=api

# Database
DATABASE_URL=postgresql://3d_printing_user:secure_password@localhost:5432/3d_printing
DB_USER=3d_printing_user
DB_PASSWORD=secure_password
DB_NAME=3d_printing
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key-change-this-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:19006

# VNPay (sandbox: https://sandbox.vnpayment.vn)
VNP_TMN_CODE=your_tmn_code
VNP_HASH_SECRET=your_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Trang frontend nhận kết quả, frontend sẽ gọi lại GET /api/v1/payment/vnpay-return để xác thực
VNP_RETURN_URL=http://localhost:3001/payment/vnpay-return
